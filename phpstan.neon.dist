parameters:
    level: max
    paths:
        - src
        - config
        - database
        - tests/Fixtures
    checkOctaneCompatibility: true
    checkModelProperties: true
    ignoreErrors:
        # NarrowSignatureAuthority deliberately narrows isA()/isAll() to string:
        # it is the fixture that proves ChecksRoles normalizes enums before the call.
        -
            identifier: argument.type
            message: '#NarrowSignatureAuthority::is(A|All)\(\) expects string, BackedEnum\|string given#'
            path: src/Concerns/HasRolesAndPermissions.php
        # ReadOnlyBelongsToMany refuses every writer before reading an argument;
        # its mixed parameters inherit Laravel's untyped array docblocks.
        -
            identifiers:
                - missingType.iterableValue
                - missingType.generics
            path: src/Models/Relations/ReadOnlyBelongsToMany.php
        # ReadOnlyPivot refuses its writes the same way, with the same inherited docblocks.
        -
            identifier: missingType.iterableValue
            path: src/Models/Relations/ReadOnlyPivot.php
