<?php

declare(strict_types=1);

use Illuminate\Database\Migrations\Migration;
use Illuminate\Database\Schema\Blueprint;
use Illuminate\Support\Facades\Schema;

/**
 * Brings a 2.x install up to the expiry column. Safe to run again: every step
 * asks first, so a run interrupted halfway finishes on the next one.
 *
 * Both pivots in the same migration, deliberately. Shipping the grants half
 * alone would leave assigned_roles offering an end date that no reader honours,
 * which is the exact hole this feature exists to close.
 */
return new class extends Migration
{
    public function up(): void
    {
        foreach ($this->pivots() as $table) {
            if ($this->schema()->hasColumn($table, 'expires_at')) {
                continue;
            }

            // Outside the unique: an assignment is the same assignment whatever
            // its end date, so firstOrCreate moves the date on the row it finds.
            $this->schema()->table($table, function (Blueprint $blueprint): void {
                $blueprint->timestamp('expires_at')->nullable()->index();
            });
        }
    }

    public function down(): void
    {
        foreach ($this->pivots() as $table) {
            if (! $this->schema()->hasColumn($table, 'expires_at')) {
                continue;
            }

            // The index first: SQLite refuses to drop a column an index still
            // names, and the rollback would abort halfway through the pair.
            $this->schema()->table($table, function (Blueprint $blueprint): void {
                $blueprint->dropIndex(['expires_at']);
                $blueprint->dropColumn('expires_at');
            });
        }
    }

    /**
     * @return list<string>
     */
    private function pivots(): array
    {
        $tables = config('warden.tables', []);
        $tables = is_array($tables) ? $tables : [];

        $assignedRoles = $tables['assigned_roles'] ?? 'assigned_roles';
        $grants = $tables['grants'] ?? 'grants';

        return [
            is_string($assignedRoles) ? $assignedRoles : 'assigned_roles',
            is_string($grants) ? $grants : 'grants',
        ];
    }

    private function schema(): Illuminate\Database\Schema\Builder
    {
        $connection = config('warden.connection');

        return Schema::connection(is_string($connection) ? $connection : null);
    }
};
