{
    "name": "elpandape/warden",
    "description": "Roles & permissions for Laravel — instance-level grants, explicit forbids, ownership, multi-tenancy, ABAC. A modernized evolution of Joseph Silber's Bouncer.",
    "keywords": [
        "laravel",
        "permissions",
        "roles",
        "abilities",
        "acl",
        "rbac",
        "abac",
        "authorization",
        "warden",
        "bouncer"
    ],
    "license": "MIT",
    "homepage": "https://github.com/elpandape/warden",
    "support": {
        "issues": "https://github.com/elpandape/warden/issues",
        "source": "https://github.com/elpandape/warden"
    },
    "authors": [
        {
            "name": "Carlos Mayorga",
            "email": "cmayorgahilario@elpanda.pe",
            "homepage": "https://carlosmayorga.me/",
            "role": "Author and maintainer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/auth": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0",
        "pestphp/pest-plugin-rector": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "rector/rector": "^2.0"
    },
    "conflict": {
        "elpandape/bouncer": "*",
        "silber/bouncer": "*"
    },
    "autoload": {
        "psr-4": {
            "ElPandaPe\\Warden\\": "src/",
            "ElPandaPe\\Warden\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ElPandaPe\\Warden\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ElPandaPe\\Warden\\WardenServiceProvider"
            ],
            "aliases": {
                "Warden": "ElPandaPe\\Warden\\Facades\\Warden"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
